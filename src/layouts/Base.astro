---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { NAV, REPO, AUTHOR_URL, ISSUE_GENERAL } from '../data/site.js';

const { title, description } = Astro.props;
const path = Astro.url.pathname;
const pageTitle = title ? `${title} | Uncooked` : 'Uncooked: the job market’s cooked. You don’t have to be.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <span class="grid-probe" aria-hidden="true"></span>
    <nav class="top" aria-label="Main">
      <div class="wrap">
        <a class="brand" href="/">Uncooked</a>
        <ul>
          {NAV.map((n) => (
            <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
        <a class="star" href={REPO} target="_blank" rel="noopener">Star on GitHub</a>
      </div>
    </nav>
    <main id="main"><slot /></main>
    <footer class="foot">
      <div class="wrap">
        <p class="foot-line">Cook with Uncooked.</p>
        <p>Built by <a href={AUTHOR_URL} target="_blank" rel="noopener">Daniel Adegoke</a>. Free and open source (MIT).</p>
        <p>This site has no analytics and sets no tracking cookies.</p>
        <p>Uncooked doesn’t promise interviews. Those depend on things no one can control.</p>
        <p><a href={REPO} target="_blank" rel="noopener">GitHub</a> · <a href={`${REPO}/blob/main/plugins/uncooked/PRIVACY.md`} target="_blank" rel="noopener">Privacy policy</a> · <a href={ISSUE_GENERAL}>Send criticism</a></p>
      </div>
    </footer>
    <script>
      const snap = () => {
        const c = parseFloat(getComputedStyle(document.querySelector('.grid-probe')).width);
        document.querySelectorAll('.grid-field .plate, .reqbox, .src').forEach((p) => {
          p.style.minHeight = '';
          p.style.minHeight = `${Math.ceil(p.offsetHeight / c) * c}px`;
        });
      };
      snap();
      addEventListener('resize', snap);
      document.fonts?.ready.then(snap);
      document.querySelectorAll('[data-copy]').forEach((btn) => {
        const label = btn.textContent;
        const live = btn.parentElement.querySelector('[aria-live]');
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy);
            btn.textContent = 'Copied';
            live.textContent = 'Command copied';
          } catch {
            const code = btn.parentElement.querySelector('code');
            const range = document.createRange();
            range.selectNodeContents(code);
            const sel = getSelection();
            sel.removeAllRanges();
            sel.addRange(range);
            btn.textContent = 'Selected';
            live.textContent = 'Command selected. Copy it with your keyboard.';
          }
          setTimeout(() => (btn.textContent = label), 2200);
        });
      });
    </script>
  </body>
</html>
